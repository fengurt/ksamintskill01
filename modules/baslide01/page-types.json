        "magazine": {
          "layout": "L8 Big Quote",
          "href": "/templates/magazine/template.html?slide=8"
        },
        "swiss": {
          "layout": "S12 Manifesto",
          "href": "/templates/swiss/template-swiss.html?slide=11"
        },
        "tableai": {
          "layout": "S12",
          "href": "/templates/tableai/template-tableai.html?slide=12"
        }
      },
      "loop": {
        "file": "/prompts/loop/quote.md",
        "prompt": "一句引用，慢下来。引号或衬线大字，来源右下。禁止三条金句墙。data-page-type=quote。",
        "checks": [
          "single quote",
          "source present",
          "no quote wall",
          "generous whitespace",
          "data-page-type=quote",
          "skin tokens only"
        ]
      }
    },
    {
      "id": "question",
      "family": "claim",
      "label": "提问 / 悬念",
      "job": "把读者停在一个问题上",

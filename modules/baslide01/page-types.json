  "loop": {
    "brand": "/prompts/loop/brand.md",
    "dir": "/prompts/loop/"
  },
  "skins": {
    "TIANSIGHT": {
      "label": "侍天报告",
      "canvas": "2880×1620",
      "template": "/templates/TIANSIGHT/gallery.html"
    },
    "magazine": {
      "label": "电子杂志 A",
      "canvas": "100vw×100vh",
      "template": "/templates/magazine/template.html"
    },
    "swiss": {
      "label": "瑞士 B",
      "canvas": "100vw×100vh",
      "template": "/templates/swiss/template-swiss.html"
    },
    "tableai": {
      "label": "Table AI C",
      "canvas": "100vw×100vh",
      "template": "/templates/tableai/template-tableai.html"
    },
    "atelier": {
      "label": "Atelier",
      "canvas": "100vw×100vh",
      "template": "/templates/atelier/template-atelier.html"
    }
  },
  "families": [
    {
      "id": "open",
      "label": "开场",
      "job": "定身份、定章节"
    },
    {
      "id": "claim",
      "label": "主张",
      "job": "一句话站住"
    },
    {
      "id": "data",
      "label": "数据",
      "job": "用数做决定"
    },
    {
      "id": "visual",
      "label": "图文",
      "job": "用图说话"
    },
    {
      "id": "structure",
      "label": "结构",
      "job": "关系、过程、对照"
    },
    {
      "id": "close",
      "label": "收束",
      "job": "结论、证伪、行动"
    }
  ],
  "types": [
    {
      "id": "cover",
      "family": "open",
      "label": "封面",
      "job": "这一份 deck 是谁、讲什么、给谁看",
      "useWhen": "第一页、章扉、品牌开场",
      "avoidWhen": "已经进入论证，还在铺身份",
      "slots": [
        "kicker",
        "title",
        "one-line decision",
        "meta chips"
      ],
      "skins": {
        "TIANSIGHT": {
          "layout": "cover",
          "href": "/templates/TIANSIGHT/jobs/cover.html"
        },
        "magazine": {
          "layout": "L1 Hero Cover",
          "href": "/templates/magazine/template.html?slide=1"
        },
        "swiss": {
          "layout": "SWISS-COVER",
          "href": "/templates/swiss/template-swiss.html?slide=1"
        },
        "tableai": {
          "layout": "S01 Index Cover",
          "href": "/templates/tableai/template-tableai.html?slide=2"
        },
        "atelier": {
          "layout": "Hero Cover",
          "href": "/templates/atelier/template-atelier.html"
        }
      },
      "loop": {
        "file": "/prompts/loop/cover.md",
        "prompt": "封面只定身份。超大标题 ≤3 行，一行决策，kicker + meta chips。留白要像杂志封面，不要仪表盘。套所选皮肤令牌与类名，data-page-type=cover。",
        "checks": [
          "title ≤3 lines",
          "one-line decision present",
          "kicker + chips",
          "no chart/KPI dump",
          "data-page-type=cover",
          "skin tokens only"
        ]
      }
    },
    {
      "id": "chapter",
      "family": "open",
      "label": "章扉",
      "job": "切幕：上一章结束，下一章开始",
      "useWhen": "章节切换、Act divider",
      "avoidWhen": "正文论证页",
      "slots": [
        "act number",
        "chapter title",
        "one-line promise"
      ],
      "skins": {
        "TIANSIGHT": {
          "layout": "divider",
          "href": "/templates/TIANSIGHT/jobs/divider.html"
        },
        "magazine": {
          "layout": "L2 Act Divider",
          "href": "/templates/magazine/template.html?slide=2"
        },
        "swiss": {
          "layout": "S03 Split Statement",
          "href": "/templates/swiss/template-swiss.html?slide=3"
        },
        "tableai": {
          "layout": "S03 Split Statement",
          "href": "/templates/tableai/template-tableai.html?slide=4"
        }
      },
      "loop": {
        "file": "/prompts/loop/chapter.md",
        "prompt": "章扉是切幕不是目录。巨大章号 + 章名 + 一句承诺。禁止正文段落、禁止图表。呼吸感优先。data-page-type=chapter。",
        "checks": [
          "act number dominant",
          "one promise line",
          "no body paragraphs",
          "no charts",
          "data-page-type=chapter",
          "skin tokens only"
        ]
      }
    },
    {
      "id": "statement",
      "family": "claim",
      "label": "主张页",
      "job": "一个判断，占满画面",
      "useWhen": "方法论一句、原则、why now",
      "avoidWhen": "需要图表才能成立的结论",
      "slots": [
        "statement",
        "supporting line"
      ],
      "skins": {
        "TIANSIGHT": {
          "layout": "statement",
          "href": "/templates/TIANSIGHT/jobs/statement.html"
        },
        "magazine": {
          "layout": "L8 Big Quote / L7 Question",
          "href": "/templates/magazine/template.html?slide=8"
        },
        "swiss": {
          "layout": "S12 Manifesto",
          "href": "/templates/swiss/template-swiss.html?slide=11"
        },
        "tableai": {
          "layout": "S12",
          "href": "/templates/tableai/template-tableai.html?slide=12"
        }
      },
      "loop": {
        "file": "/prompts/loop/statement.md",
        "prompt": "一个判断占满画面。页眉一行 logo+chip。主句在纸色井里，辅句用 lede 或依据表。禁止孤儿页、禁止图。data-page-type=statement。",
        "checks": [
          "one claim only",
          "supporting lines complete",
          "no orphan leftover page",
          "no charts",
          "data-page-type=statement",
          "skin tokens only"
        ]
      }
    },

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unified-data-package:v1:field-dictionary-schema",
  "title": "Unified Data Package v1 field dictionary",
  "type": "object",
  "required": ["package", "spec_version", "timezone", "tables"],
  "properties": {
    "package": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*_v[0-9]+(?:_[0-9]+){0,2}$"},
    "spec_version": {"const": "unified-data-package/v1"},
    "timezone": {"type": "string", "minLength": 1},
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "grain", "primary_key", "foreign_keys", "columns"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+){2,}$"},
          "title_zh": {"type": "string"},
          "description": {"type": "string"},
          "grain": {"type": "string", "minLength": 1},
          "primary_key": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "business_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "foreign_keys": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["columns", "references", "referenced_columns"],
              "properties": {
                "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "references": {"type": "string", "minLength": 1},
                "referenced_columns": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              },
              "additionalProperties": true
            }
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "title_zh",
                "description",
                "physical_type",
                "logical_type",
                "semantic_role",
                "unit",
                "nullable",
                "null_means",
                "sensitivity",
                "derived"
              ],
              "properties": {
                "name": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
                "title_zh": {"type": "string"},
                "description": {"type": "string"},
                "physical_type": {
                  "type": "string",
                  "pattern": "^(string|boolean|int32|int64|float32|float64|date32|decimal\\([0-9]+,[0-9]+\\)|timestamp\\[(s|ms|us|ns),tz=[^\\]]+\\]|list<(string|int32|int64|float32|float64)>)$"
                },
                "logical_type": {"type": "string", "minLength": 1},
                "semantic_role": {"enum": ["identifier", "foreign_key", "dimension", "measure", "timestamp", "label", "text", "asset_reference"]},
                "unit": {"type": ["string", "null"]},
                "nullable": {"type": "boolean"},
                "null_means": {"type": ["string", "null"]},
                "sensitivity": {"type": "string", "minLength": 1},
                "derived": {"type": "boolean"},
                "formula": {"type": "string"},
                "constraints": {"type": "object"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

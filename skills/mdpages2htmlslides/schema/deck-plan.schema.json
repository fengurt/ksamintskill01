{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GF4p2slides deck-plan v2",
  "type": "object",
  "required": ["contract_version", "title", "argument", "pages"],
  "properties": {
    "contract_version": {"const": "2.0.0"},
    "title": {"type": "string", "minLength": 1},
    "mode": {"enum": ["slide", "slides", "responsive", "print"]},
    "aspect": {"const": "16:9"},
    "source": {"type": "string"},
    "genre": {"enum": ["diagnosis", "system", "briefing", "roadmap", "dossier"]},
    "theme": {"type": "string"},
    "argument": {
      "type": "object",
      "required": ["root", "nodes"],
      "properties": {
        "root": {"type": "string"},
        "nodes": {"type": "array", "minItems": 1}
      }
    },
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["dataset", "query_hash", "as_of", "transform_chain", "owner"]
    },
    "page": {
      "type": "object",
      "required": ["id", "node", "claim", "evidence", "template", "title", "content", "layout"],
      "properties": {
        "id": {"type": "string", "pattern": "^p-[0-9]{3,4}$"},
        "node": {
          "type": "object",
          "required": ["role"],
          "properties": {
            "role": {"enum": ["frame", "situation", "complication", "question", "claim", "evidence", "back-matter"]},
            "supports": {"type": ["string", "null"]},
            "shared": {"type": "boolean"}
          }
        },
        "claim": {
          "type": "object",
          "required": ["subject", "measure", "direction", "period", "scope", "render"]
        },
        "intent": {"type": ["string", "null"], "enum": [null, "ranking", "magnitude", "part-to-whole", "change-over-time", "deviation", "distribution", "correlation", "flow", "geo"]},
        "evidence": {"type": "array"},
        "template": {"enum": ["cover", "toc", "chapter", "statement", "kpi", "compare", "matrix", "chart", "chart-table", "roster", "verdict", "readme"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "takeaway": {"type": "string"},
        "visualization": {"type": ["string", "null"]},
        "layout": {
          "type": "object",
          "required": ["solved", "grid", "trace"],
          "properties": {
            "solved": {"type": "string"},
            "grid": {"const": "12x8"},
            "trace": {"type": "array", "items": {"type": "string"}}
          }
        },
        "pack": {"enum": ["air", "mid", "tight"]},
        "units": {"type": "array", "items": {"type": "string"}},
        "overflow_of": {"type": ["string", "null"]},
        "content": {
          "type": "object",
          "required": ["blocks"],
          "properties": {
            "blocks": {"type": "array", "items": {"type": "object", "required": ["kind"]}}
          }
        }
      }
    }
  }
}

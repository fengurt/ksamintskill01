{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GF4p2slides deck-plan",
  "type": "object",
  "required": ["contract_version", "title", "pages"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "title": {"type": "string", "minLength": 1},
    "mode": {"enum": ["slide", "slides", "responsive", "print"]},
    "source": {"type": "string"},
    "genre": {"enum": ["diagnosis", "system", "briefing", "roadmap", "dossier"]},
    "theme": {"type": "string"},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "page": {
      "type": "object",
      "required": ["id", "template", "title", "content"],
      "properties": {
        "id": {"type": "string", "pattern": "^p-[0-9]{3,4}$"},
        "template": {
          "enum": [
            "cover", "toc", "chapter", "statement", "kpi", "compare",
            "matrix", "chart", "chart-table", "roster", "verdict", "readme",
            "quote", "playbook", "gallery", "interactive"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string"},
        "takeaway": {"type": "string"},
        "visualization": {"type": ["string", "null"]},
        "layout": {"type": ["string", "null"]},
        "pack": {"enum": ["air", "mid", "tight"]},
        "units": {"type": "array", "items": {"type": "string"}},
        "overflow_of": {"type": ["string", "null"]},
        "content": {
          "type": "object",
          "required": ["blocks"],
          "properties": {
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["kind"],
                "properties": {"kind": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}

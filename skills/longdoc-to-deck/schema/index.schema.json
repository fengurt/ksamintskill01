{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ksamintskill01.local/schemas/index.json",
  "title": "longdoc-to-deck index",
  "type": "object",
  "required": ["version", "total_units", "units"],
  "properties": {
    "version": { "type": "string" },
    "source": { "type": ["string", "null"] },
    "total_units": { "type": "integer", "minimum": 0 },
    "total_chars": { "type": "integer", "minimum": 0 },
    "kinds": { "type": "object" },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "heading_path", "char_count", "line_start", "line_end", "digest"],
        "properties": {
          "id": { "type": "string", "pattern": "^u-\\d{4}$" },
          "kind": {
            "type": "string",
            "enum": ["prose", "list", "table", "code", "quote", "figure", "number-block", "heading"]
          },
          "heading_path": { "type": "array", "items": { "type": "string" } },
          "char_count": { "type": "integer", "minimum": 0 },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "digest": { "type": "string" }
        }
      }
    }
  }
}

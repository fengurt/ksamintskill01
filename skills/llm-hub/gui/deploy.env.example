# Copy to deploy.env and fill in. Never commit deploy.env.

# Admin key for the dashboard + key management. Generate a strong one:
#   openssl rand -base64 32
LLMHUB_ADMIN_KEY=sk-hub-admin-CHANGE-ME

# Optional: allow bare model names (no provider: prefix) to route to this provider.
# LLMHUB_DEFAULT_PROVIDER=deepseek

# Provider keys are read from the ENCRYPTED store secrets/keys.enc and decrypted
# at runtime with the local private PEM (mounted at /app/secrets/llmhub_private.pem).
# Prepare locally:  scripts/gen-keypair.sh  &&  scripts/encrypt-keys.sh
# If the PEM is passphrase-protected, supply it here (keep deploy.env off git):
# LLMHUB_PEM_PASSPHRASE=...

# Escape hatch — override a single provider key without the encrypted store:
# LLMHUB_KEY_DEEPSEEK=sk-...
# LLMHUB_KEY_LIBLIB=AccessKey:SecretKey
